# ---------------------------------------------------------------------------
# Vivado 工程输出（几百 MB），全部不入库
# 工程由 build/tcl/build_all.tcl 一键重建，不需要提交 .xpr / .bd / runs
# ---------------------------------------------------------------------------
build/vivado/
.Xil/
*.jou
*.log
*.str
*.dcp
*.bit
*.hwh
*.xsa
*.ltx
*.pb
*.wdb
*.vcd
*.rpx
*.dmp
webtalk*
usage_statistics*

# 综合/实现原始报告体积大且随器件版本变化；
# build/reports/ 下由脚本挑出来的那几份要入库（见下方 ! 例外）
*.rpt
!build/reports/*.rpt

# 上板产物：bit / xsa 由构建脚本拷到这里，属于本地生成物
board/artifacts/

# BD 框图导出（export_bd_diagram.tcl 生成）
report/figures/bd_dataflow.*

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
